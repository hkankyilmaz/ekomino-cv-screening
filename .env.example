# Copy this file to .env and fill in your key:   cp .env.example .env
# .env is git-ignored, so the key never ends up on GitHub.

# Google Gemini API key, create one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# ---------------------------------------------------------------------------
# Performance & gain analysis — AS-IS (manual process) assumptions.
# Defaults are typical-case estimates. Replace them with your own stopwatch measurements
# (method in docs/performance-analysis.md).
# ---------------------------------------------------------------------------
ASIS_READ_CV_MIN=6          # minutes an HR specialist needs to read & evaluate one CV
ASIS_RECORD_MIN=1.5         # minutes to type the result into the spreadsheet
ASIS_QUESTIONS_MIN=12       # minutes to prepare tailored interview questions
ASIS_MAIL_MIN=4             # minutes to write an invitation mail
ASIS_ERROR_RATE=0.12        # share of manual records with a data-entry / consistency error
TOBE_REVIEW_MIN=1.5         # minutes HR needs to review & approve an AI draft
HR_HOURLY_COST_TRY=350      # fully loaded hourly cost of an HR specialist (TRY)
AI_COST_PER_CV_TRY=0.05     # Gemini API cost per CV (TRY)
