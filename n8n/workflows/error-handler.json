{
  "id": "EkominoErrorHnd1",
  "name": "Ekomino · Error Handler",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0000-4000-8000-000000000901",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "Ekomino Automation <automation@ekomino.local>",
        "toEmail": "hr@ekomino.local",
        "subject": "=[Automation error] {{ $json.workflow.name }}",
        "emailFormat": "text",
        "text": "=The CV screening workflow stopped with an error.\n\nWorkflow : {{ $json.workflow.name }}\nNode     : {{ $json.execution.lastNodeExecuted }}\nError    : {{ $json.execution.error.message }}\nExecution: {{ $json.execution.id }}\n\nPlease check the affected CV in the HR panel (it is listed under \"Manual review\") and the execution in n8n.",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000902",
      "name": "Notify HR",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        240,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "ekominoMailpitSmtp",
          "name": "Mailpit SMTP (local)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://web:3000/api/n8n/error",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.execution.error?.message, node: $json.execution.lastNodeExecuted, execution_id: $json.execution.id }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000903",
      "name": "Log Alert to Panel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        400
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "On Workflow Error": {
      "main": [
        [
          {
            "node": "Notify HR",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log Alert to Panel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
